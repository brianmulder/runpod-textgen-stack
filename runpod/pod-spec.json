{
  "name": "tg-webui",
  "cloudType": "COMMUNITY",
  "computeType": "GPU",
  "imageName": "atinoda/text-generation-webui:default-nightly",
  "gpuCount": 1,
  "gpuTypeIds": ["$GPU_TYPE"],
  "containerDiskInGb": 40,
  "networkVolumeId": "$VOLUME_ID",
  "volumeMountPath": "/workspace",
  "ports": ["8443/tcp"],
  "dockerEntrypoint": ["/entrypoint.sh"],
  "dockerStartCmd": [
    "--listen",
    "--port",
    "7860",
    "--api",
    "--extensions",
    "openai",
    "--model-dir",
    "$MODEL_DIR"
  ]
}
